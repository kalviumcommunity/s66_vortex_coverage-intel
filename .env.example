# ─────────────────────────────────────────────────────────────
# Coverage Intel — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# Full reference: docs/DEPLOYMENT.md §3
# ─────────────────────────────────────────────────────────────

# ── Enterprise RAG Stack: Pinecone + xAI Grok ─────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_EMBED_MODEL=multilingual-e5-large
XAI_GROK_API_KEY=
XAI_GROK_BASE_URL=https://api.x.ai/v1
XAI_GROK_MODEL=grok-2-latest

# ── Required Baseline ─────────────────────────────────────────
CI_LLM_API_KEY=
CI_EMBEDDING_API_KEY=
CI_UPLOAD_ACCESS_KEY=

# ── Models ──────────────────────────────────────────────────
CI_LLM_MODEL=
CI_EMBEDDING_MODEL=
CI_LLM_BASE_URL=
CI_LLM_TIMEOUT_SECONDS=30
CI_EMBEDDING_BASE_URL=
CI_RERANK_MODEL=

# ── Retrieval ───────────────────────────────────────────────
CI_TOP_K=5
CI_HYBRID_ALPHA=0.7
CI_SIMILARITY_THRESHOLD=0.35
CI_RELEVANCE_FLOOR=0.30
CI_RERANK_ENABLED=false
CI_RERANK_TOP_N=20

# ── Ingestion ───────────────────────────────────────────────
CI_CHUNK_SIZE_TOKENS=500
CI_CHUNK_OVERLAP_TOKENS=50
CI_CORPUS_DIR=data/corpus

# ── Generation ──────────────────────────────────────────────
CI_GENERATION_TEMPERATURE=0.2
CI_MAX_CONTEXT_TOKENS=6000

# ── Storage & Ops ───────────────────────────────────────────
CI_VECTOR_STORE=chroma
CI_LOG_LEVEL=INFO
CI_LOG_FORMAT=json
CI_API_HOST=127.0.0.1
CI_API_PORT=8000
