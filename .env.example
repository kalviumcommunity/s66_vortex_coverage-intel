# ─────────────────────────────────────────────────────────────
# Coverage Intel — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# Full reference: docs/DEPLOYMENT.md §3
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────
CI_LLM_API_KEY=
CI_EMBEDDING_API_KEY=
# Protects the upload endpoint (FR-16). Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CI_UPLOAD_ACCESS_KEY=

# ── Models ──────────────────────────────────────────────────
CI_LLM_MODEL=
CI_EMBEDDING_MODEL=
CI_LLM_BASE_URL=
CI_EMBEDDING_BASE_URL=
# Cross-encoder reranker (LU 3.35, optional)
CI_RERANK_MODEL=

# ── Retrieval ───────────────────────────────────────────────
CI_TOP_K=5
CI_HYBRID_ALPHA=0.7
# CALIBRATE on the eval set — do not inherit this value across
# embedding models. See docs/EVALUATION.md §5
CI_SIMILARITY_THRESHOLD=0.35
CI_RELEVANCE_FLOOR=0.30
CI_RERANK_ENABLED=false
CI_RERANK_TOP_N=20

# ── Ingestion ───────────────────────────────────────────────
CI_CHUNK_SIZE_TOKENS=500
CI_CHUNK_OVERLAP_TOKENS=50
CI_CORPUS_DIR=data/corpus

# ── Generation ──────────────────────────────────────────────
# Must not exceed 0.2 (FR-12)
CI_GENERATION_TEMPERATURE=0.2
CI_MAX_CONTEXT_TOKENS=6000

# ── Storage & Ops ───────────────────────────────────────────
# chroma | qdrant
CI_VECTOR_STORE=chroma
CI_QDRANT_URL=
CI_LOG_LEVEL=INFO
CI_LOG_FORMAT=json

# ── API ─────────────────────────────────────────────────────
CI_API_HOST=127.0.0.1
CI_API_PORT=8000
CI_MAX_UPLOAD_MB=25
