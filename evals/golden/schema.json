{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coverage Intel golden evaluation question",
  "type": "object",
  "required": ["qid", "category", "question", "acceptable_status"],
  "additionalProperties": false,
  "properties": {
    "qid": { "type": "string", "description": "Stable unique identifier" },
    "category": {
      "type": "string",
      "enum": ["normal_coverage", "exclusion_endorsement", "version_conflict", "insufficient_evidence"]
    },
    "question": { "type": "string", "minLength": 1 },
    "scenario": {
      "type": "object",
      "properties": {
        "policy_type": { "type": ["string", "null"] },
        "date_of_loss": { "type": ["string", "null"], "format": "date" },
        "jurisdiction": { "type": ["string", "null"] },
        "claim_type": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "expected_document_ids": { "type": "array", "items": { "type": "string" } },
    "expected_chunk_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ground truth for retrieval recall@k"
    },
    "expected_applicable_document_id": {
      "type": ["string", "null"],
      "description": "version_conflict: the version in effect on date_of_loss"
    },
    "expected_warnings": { "type": "array", "items": { "type": "string" } },
    "must_not_be_cited": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Catches a superseded version being presented as current"
    },
    "acceptable_status": {
      "type": "array",
      "items": { "type": "string", "enum": ["grounded", "weak_evidence", "conflicting", "insufficient_evidence"] }
    }
  }
}
